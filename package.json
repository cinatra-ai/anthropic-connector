{
  "name": "@cinatra-ai/anthropic-connector",
  "version": "0.1.3",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "src",
    "!src/__tests__"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./register": "./src/register.ts",
    "./deps": "./src/deps.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest",
    "lint": "eslint . --no-inline-config"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.4.3",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "@cinatra-ai/sdk-extensions": "*",
    "@cinatra-ai/sdk-ui": "*"
  },
  "peerDependenciesMeta": {
    "@cinatra-ai/sdk-extensions": {
      "optional": true
    },
    "@cinatra-ai/sdk-ui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@typescript-eslint/parser": "8.61.0",
    "eslint": "10.4.1",
    "typescript": "5.9.3"
  },
  "cinatra": {
    "apiVersion": "cinatra.ai/v1",
    "kind": "connector",
    "vendor": {
      "key": "cinatra-ai",
      "name": "Cinatra"
    },
    "displayName": "Anthropic",
    "dependencies": [],
    "serverEntry": "./register",
    "requestedHostPorts": [
      "capabilities",
      "ui"
    ],
    "sdkAbiRange": "^2",
    "uiSurface": "schema-config",
    "configSchema": {
      "title": "Anthropic",
      "description": "Connect an Anthropic API key so Claude-powered agents and workflows can run. The key is stored securely via the connection service.",
      "fields": [
        {
          "kind": "banner",
          "label": "Result",
          "variants": [
            { "name": "saved", "tone": "success", "message": "Anthropic connection saved." },
            { "name": "cleared", "tone": "warning", "message": "Anthropic connection cleared." },
            { "name": "error", "tone": "destructive", "message": "Something went wrong." }
          ]
        },
        {
          "kind": "advisory",
          "label": "API key storage",
          "tone": "info",
          "probeActionId": "connectionServiceReady",
          "whenReady": "API keys are stored securely via the connection service.",
          "whenNotReady": "Configure the connection service first so Anthropic API requests can authenticate."
        },
        {
          "kind": "status-probe",
          "label": "Connection",
          "actionId": "connectionStatus",
          "description": "Check whether an Anthropic API key is configured."
        },
        {
          "kind": "secret",
          "key": "apiKey",
          "label": "Anthropic API key",
          "description": "Create a key at console.anthropic.com. Write-only — the stored value is never shown again."
        },
        {
          "kind": "select",
          "key": "defaultModel",
          "label": "Default model",
          "defaultValue": "claude-sonnet-4-6",
          "description": "The default Claude model agents use unless an agent overrides it.",
          "options": [
            { "value": "claude-opus-4-7", "label": "Claude Opus 4.7" },
            { "value": "claude-opus-4", "label": "Claude Opus 4" },
            { "value": "claude-sonnet-4-6", "label": "Claude Sonnet 4.6" },
            { "value": "claude-haiku-4-5-20251001", "label": "Claude Haiku 4.5" }
          ]
        },
        {
          "kind": "named-action",
          "label": "Save connection",
          "actionId": "saveConnection"
        },
        {
          "kind": "named-action",
          "label": "Clear connection",
          "actionId": "clearConnection",
          "confirm": "Clear the stored Anthropic connection?"
        }
      ]
    }
  }
}
